{
  "family": "cisce-scraper",
  "about": "CISCE affiliated schools (locate.cisce.org): code, name, principal, address, PIN, ICSE/ISC/CVE, type, coordinates.",
  "setup": [
    "pip install -r requirements.txt",
    "python -m playwright install --with-deps chromium"
  ],
  "tasks": {
    "crawl": [
      "python",
      "crawl.py"
    ],
    "history": [
      "python",
      "wayback.py",
      "--task"
    ]
  }
}
